# Option 1 (recommended): path to your existing MCP configuration OUTSIDE the repo.
IFIND_MCP_CONFIG=
# Option 2: Authorization header value, preserved exactly as provided by iFinD.
# Used only when IFIND_MCP_CONFIG is empty. Never commit the real value.
IFIND_MCP_AUTHORIZATION=
# Direct HTTPS by default; set true to use your system HTTP(S) proxy variables.
IFIND_TRUST_ENV=false
# This is documentation only. The service reads process environment variables;
# it does not automatically load .env files.
