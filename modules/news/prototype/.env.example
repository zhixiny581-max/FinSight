# 本地后端监听端口
PORT=3000

# 将自己的 iFinD MCP 授权值填在本机 .env 中。此文件不会被 Git 提交。
# 不要加 Bearer 前缀，保持与平台提供的 Authorization 原值一致。
IFIND_MCP_AUTHORIZATION=

# 已安装 iFinD Skill 的用户也可以不填上面的授权值，继续使用 Skill 配置。
# 可选；默认读取当前用户目录下的 .codex/skills/ifind-finance-data
# IFIND_SKILL_DIR=C:\path\to\ifind-finance-data

# DeepSeek 配置：真实密钥只填写在本地 .env，不要提交或发到聊天中
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
