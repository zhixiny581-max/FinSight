# Secrets and local environment files
.env
.env.*
!.env.example

# 本地接口凭据：展示机与同学各自填写，只保留模板进仓库
**/api-config.json
!**/api-config.example.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# JavaScript
node_modules/
dist/
build/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local outputs
*.log
eval/results/
FinSight-news-prototype-*.zip

# 双版本发布：本地配置、运行记录与生成包
**/data/
**/mcp_config.json
**/*credentials*.json
**/*.pem
**/*.key
.archify/
/release/

# 旧版静态交易日历是源码，不是本机运行数据
!modules/market/data/
modules/market/data/*
!modules/market/data/calendar.json

# 流程图可重生成的本机校验回执
docs/presentation/new-analysis/*.json
